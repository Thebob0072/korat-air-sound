# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า
# cp .env.example .env

# ── ตัวเลือก 1: Cloud SQL Production ─────────────────────────────────────────
# (whitelist local IP ก่อนใช้งาน: Google Cloud Console > SQL > Connections)
# DATABASE_URL="mysql://root:YOUR_PASSWORD@34.158.34.228:3306/korat_air_sound"

# ── ตัวเลือก 2: Local Docker MySQL (dev dev) ─────────────────────────────────
# DATABASE_URL="mysql://dev:devpass@127.0.0.1:3306/korat_air_sound"

# ── ตัวเลือก 3: Docker Compose (production local) ────────────────────────────
DATABASE_URL="mysql://korat_user:korat_pass@localhost:3306/korat_air_sound"

NODE_ENV=development

# หมายเหตุ: Cloud Run production ใช้ socket connection ผ่าน Cloud SQL Auth Proxy
# ไม่ต้องตั้งค่า DATABASE_URL นี้บน Cloud Run — ตั้งผ่าน Cloud Run env vars
